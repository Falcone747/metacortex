{
  "scms": [
    {
      "id": "b2b-saas-acquisition",
      "name": "Customer Acquisition — B2B SaaS",
      "domain": "acquisition",
      "description": "Modèle causal d'acquisition pour PME B2B SaaS (équipe vente + produit). Variables: outbound, pricing, sales_capacity, MQL, SQL, deals_won, ARR.",
      "vars": [
        {"id": "outbound_volume", "label": "Volume outbound", "unit": "messages/mois"},
        {"id": "sales_capacity", "label": "Capacité commerciale (ETP)", "unit": "ETP"},
        {"id": "pricing_tier", "label": "Niveau de prix", "unit": "index 0-1"},
        {"id": "MQL", "label": "Leads qualifiés marketing", "unit": "leads/mois"},
        {"id": "SQL", "label": "Leads qualifiés sales", "unit": "leads/mois"},
        {"id": "win_rate", "label": "Taux de closing", "unit": "ratio"},
        {"id": "ARR", "label": "ARR (Annual Recurring Revenue)", "unit": "k€/an"}
      ],
      "edges": [
        {"from": "outbound_volume", "to": "SQL"},
        {"from": "outbound_volume", "to": "MQL"},
        {"from": "MQL", "to": "SQL"},
        {"from": "sales_capacity", "to": "win_rate"},
        {"from": "SQL", "to": "win_rate"},
        {"from": "win_rate", "to": "ARR"},
        {"from": "pricing_tier", "to": "ARR"},
        {"from": "pricing_tier", "to": "win_rate"}
      ],
      "equations": {
        "outbound_volume": {"parents": [], "coef": {}, "intercept": 1000, "sigma": 100},
        "sales_capacity": {"parents": [], "coef": {}, "intercept": 5, "sigma": 0.3},
        "pricing_tier": {"parents": [], "coef": {}, "intercept": 0.5, "sigma": 0.05},
        "MQL": {"parents": ["outbound_volume"], "coef": {"outbound_volume": 0.15}, "intercept": 50, "sigma": 30},
        "SQL": {"parents": ["outbound_volume", "MQL"], "coef": {"outbound_volume": 0.05, "MQL": 0.4}, "intercept": 20, "sigma": 25},
        "win_rate": {"parents": ["sales_capacity", "SQL", "pricing_tier"], "coef": {"sales_capacity": 0.03, "SQL": 0.001, "pricing_tier": -0.15}, "intercept": 0.1, "sigma": 0.02},
        "ARR": {"parents": ["win_rate", "pricing_tier"], "coef": {"win_rate": 800, "pricing_tier": 200}, "intercept": 50, "sigma": 30}
      }
    },
    {
      "id": "mfg-delays",
      "name": "Manufacturing Delays — B2B Fabricant",
      "domain": "operations",
      "description": "Modèle causal des retards de livraison pour fabricant B2B 80 personnes. Variables: inflow, capacity, priority_quality, throughput, backlog, on_time_rate.",
      "vars": [
        {"id": "order_inflow", "label": "Commandes entrantes", "unit": "commandes/mois"},
        {"id": "capacity_h", "label": "Capacité production", "unit": "heures/mois"},
        {"id": "priority_quality", "label": "Qualité d'attribution priorité", "unit": "score 0-1"},
        {"id": "throughput", "label": "Débit de production", "unit": "commandes/mois"},
        {"id": "backlog", "label": "Carnet en retard", "unit": "commandes"},
        {"id": "on_time_rate", "label": "Taux livraison à temps", "unit": "ratio"}
      ],
      "edges": [
        {"from": "order_inflow", "to": "backlog"},
        {"from": "capacity_h", "to": "throughput"},
        {"from": "priority_quality", "to": "throughput"},
        {"from": "throughput", "to": "backlog"},
        {"from": "backlog", "to": "on_time_rate"},
        {"from": "priority_quality", "to": "on_time_rate"}
      ],
      "equations": {
        "order_inflow": {"parents": [], "coef": {}, "intercept": 120, "sigma": 15},
        "capacity_h": {"parents": [], "coef": {}, "intercept": 720, "sigma": 40},
        "priority_quality": {"parents": [], "coef": {}, "intercept": 0.3, "sigma": 0.05},
        "throughput": {"parents": ["capacity_h", "priority_quality"], "coef": {"capacity_h": 0.15, "priority_quality": 30}, "intercept": 0, "sigma": 5},
        "backlog": {"parents": ["order_inflow", "throughput"], "coef": {"order_inflow": 0.4, "throughput": -0.5}, "intercept": 0, "sigma": 4},
        "on_time_rate": {"parents": ["backlog", "priority_quality"], "coef": {"backlog": -0.003, "priority_quality": 0.4}, "intercept": 0.95, "sigma": 0.04}
      }
    },
    {
      "id": "employee-retention",
      "name": "Employee Retention — PME Services",
      "domain": "rh",
      "description": "Modèle causal de rétention employé dans une société de services (50 personnes). Variables: comp, mgmt_quality, workload, engagement, turnover, hiring_cost.",
      "vars": [
        {"id": "comp_ratio", "label": "Ratio salaire vs marché", "unit": "ratio"},
        {"id": "mgmt_quality", "label": "Qualité du management", "unit": "score 0-1"},
        {"id": "workload", "label": "Charge de travail", "unit": "h/sem"},
        {"id": "engagement", "label": "Engagement employé", "unit": "score 0-1"},
        {"id": "turnover_rate", "label": "Taux de turnover annuel", "unit": "ratio"},
        {"id": "hiring_cost", "label": "Coût total recrutement", "unit": "k€/an"}
      ],
      "edges": [
        {"from": "comp_ratio", "to": "engagement"},
        {"from": "mgmt_quality", "to": "engagement"},
        {"from": "workload", "to": "engagement"},
        {"from": "engagement", "to": "turnover_rate"},
        {"from": "turnover_rate", "to": "hiring_cost"},
        {"from": "hiring_cost", "to": "mgmt_quality"}
      ],
      "equations": {
        "comp_ratio": {"parents": [], "coef": {}, "intercept": 1.0, "sigma": 0.03},
        "mgmt_quality": {"parents": ["hiring_cost"], "coef": {"hiring_cost": -0.0008}, "intercept": 0.7, "sigma": 0.05},
        "workload": {"parents": [], "coef": {}, "intercept": 42, "sigma": 2},
        "engagement": {"parents": ["comp_ratio", "mgmt_quality", "workload"], "coef": {"comp_ratio": 0.3, "mgmt_quality": 0.5, "workload": -0.008}, "intercept": 0.3, "sigma": 0.04},
        "turnover_rate": {"parents": ["engagement"], "coef": {"engagement": -0.3}, "intercept": 0.25, "sigma": 0.02},
        "hiring_cost": {"parents": ["turnover_rate"], "coef": {"turnover_rate": 300}, "intercept": 20, "sigma": 10}
      }
    }
  ]
}
